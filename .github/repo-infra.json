{
  "moving_major_tag": false,
  "version_files": [
    {
      "path": "Cargo.toml",
      "pattern": "^version\\s*=\\s*\"[^\"]*\"",
      "replacement": "version = \"$VERSION\"",
      "verify": "^version\\s*=\\s*\"$VERSION\""
    },
    {
      "path": "Cargo.lock",
      "pattern": "^name = \"mtuspy\"\nversion = \"[^\"]*\"",
      "replacement": "name = \"mtuspy\"\nversion = \"$VERSION\"",
      "verify": "^name = \"mtuspy\"\nversion = \"$VERSION\""
    }
  ],
  "release_files": [
    "Formula/mtuspy.rb"
  ],
  "release_assets": [
    "mtuspy-*-x86_64-unknown-linux-musl.tar.gz",
    "mtuspy-*-aarch64-unknown-linux-musl.tar.gz",
    "mtuspy-*-x86_64-unknown-illumos.tar.gz",
    "mtuspy-*-x86_64-apple-darwin.tar.gz",
    "mtuspy-*-aarch64-apple-darwin.tar.gz",
    "mtuspy-*-x86_64-pc-windows-msvc.zip",
    "mtuspy-*-aarch64-pc-windows-msvc.zip",
    "mtuspy_*_amd64.deb",
    "mtuspy_*_arm64.deb",
    "mtuspy-*.x86_64.rpm",
    "mtuspy-*.aarch64.rpm",
    "mtuspy-*.arm64_sonoma.bottle.tar.gz"
  ],
  "gitea_packages": {
    "url": "https://gitea.oetiker.ch",
    "owner": "oposs",
    "debian": {
      "distribution": "stable",
      "component": "main"
    },
    "rpm": {
      "group": ""
    }
  }
}
